{
  "name": "admin-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "admin-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    6,
    7,
    8,
    9,
    10,
    11
  ],
  "description": "The admin single-page app: the signed-in admin creates, edits and deletes posts, sees every post in one place, and removes comments guests left. Does not expose any reader-facing browsing experience.",
  "dependencies": [
    {
      "kind": "component",
      "name": "blog-api",
      "description": "Creates, edits and deletes posts, lists all posts, and removes comments.",
      "wiring": {
        "endpoint": {
          "component": "simplest-crud-blog-blog-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "BLOG_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "simplest-crud-blo-757a146f",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
