{
  "name": "blog-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "blog-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "description": "Backs both blog web apps: stores and serves posts and comments in Postgres. Owns the posts and comments resources, enforces the permission scopes on every operation, and verifies the gateway's signed assertion. Does not send notifications and calls no external service.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "blog-db",
      "resourceType": "postgres-cnpg",
      "parameters": {
        "instances": 1,
        "storage": "1Gi",
        "version": "16"
      },
      "wiring": {
        "ref": "simplest-crud-blog-blog-db",
        "envBindings": {
          "dbname": "BLOG_DB_DBNAME",
          "host": "BLOG_DB_HOST",
          "password": "BLOG_DB_PASSWORD",
          "port": "BLOG_DB_PORT",
          "user": "BLOG_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "simplest-crud-blo-757a146f",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
